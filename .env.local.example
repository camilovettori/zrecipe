# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_BUSINESS=
STRIPE_SECRET_KEY=

# App
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=

# AI
ANTHROPIC_API_KEY=

# Stock photos (recipe image search)
PEXELS_API_KEY=

# Resend (transactional/support email) — domain support@auth.ziffera.ie must
# be verified in the Resend dashboard for this to send.
RESEND_API_KEY=

# Square POS integration (server-only; never expose these as NEXT_PUBLIC_ variables)
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SQUARE_TOKEN_ENCRYPTION_KEY=
# Optional; defaults to SQUARE_TOKEN_ENCRYPTION_KEY for signed OAuth state.
SQUARE_OAUTH_STATE_SECRET=
# Must be exactly 'sandbox' or 'production' — no default, the app throws if unset or misspelled.
SQUARE_ENVIRONMENT=
# Must exactly match the Redirect URL registered for your Square application.
SQUARE_OAUTH_REDIRECT_URL=https://zrecipe.ie/api/integrations/square/callback
# Pin a Square API version if desired. The app otherwise uses the current version at implementation time.
SQUARE_API_VERSION=2026-08-19
